# ==========================================
# Kredo Credential Manager Environment Variables
# ==========================================
# Copy this file to '.env' and fill in the values below.

# --- Server Configuration ---
# Port on which the server will run (e.g., 8000)
PORT=8000
# Environment mode (development, production, or test)
NODE_ENV=development

# --- Client Configuration ---
# The URL of the frontend application (used for CORS and redirects)
CLIENT_URL=http://localhost:3000

# --- Database Configuration ---
# Connection string for the MongoDB database
MONGODB_URI=

# --- Security & Hashing ---
# Number of rounds for bcrypt password hashing (10 is recommended)
BCRYPT_SALT_ROUNDS=10

# --- JWT Authentication (Token Expiration) ---
# Expiry time in seconds for the access token (e.g., 900 for 15 minutes)
JWT_ACCESS_TOKEN_EXPIRY=900
# Expiry time in seconds for the refresh token (e.g., 604800 for 7 days)
JWT_REFRESH_TOKEN_EXPIRY=604800

# --- JWT Authentication (Secrets) ---
# Secret keys for signing JWT tokens. 
# It is highly recommended to generate secure random strings for these.
# Example command to generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
